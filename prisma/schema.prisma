generator client {
  provider = "prisma-client"
  output   = "./generated"
  runtime = "bun"
}

datasource db {
  provider = "postgresql"
}

enum CountryCode {
  EU
  JP
  UK
  US
  CA
  AU
  NZ
  SG
  HK
  CN
  KR
  BR
}

enum LocalizationStatus {
  GENERATING
  COMPLETED
  FAILED
}

enum StoreStatus {
  PENDING
  // ANALYZING
  // ANALYZED
  // ANALYSIS_FAILED
  LOCALIZING
  LOCALIZED
  LOCALIZATION_FAILED
}

model StoreInformation {
  id        String   @id @default(uuid())
  name      String?
  images    Bytes[]

  // Analysis results
  analysis String?

  variants  LocalizedVariant[]
  status    StoreStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LocalizedVariant {
  id            String            @id @default(uuid())
  storeInformationId  String
  storeInformation    StoreInformation @relation(fields: [storeInformationId], references: [id], onDelete: Cascade)

  region        CountryCode

  localizedText  String[]
  generatedImages Bytes[]

  status        LocalizationStatus @default(GENERATING)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
